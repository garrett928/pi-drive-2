<?xml version="1.0" encoding="utf-8"?>
<!--
  Pi Drive app icon foreground — π glyph in warm orange.

  The icon uses a geometric bold π shape on a transparent background.
  Dimensions: 108×108dp. The glyph fits within the safe zone (inner 72×72).

  Color: warm orange #D88A30 — matches AccentOptions.WarmOrange.base = Color(0xFFD88A30).

  Path describes the π symbol as a single filled polygon:
    ─ Top horizontal bar (x: 26→82, y: 36→45)
    ─ Left leg (x: 33→44, y: 45→78)
    ─ Right leg (x: 64→75, y: 45→78)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      π glyph: single clockwise path describing the outer boundary of the symbol.
      Reads as: draw bar top → right leg → gap → left leg → bar bottom → close.
    -->
    <path
        android:fillColor="#D88A30"
        android:fillType="nonZero"
        android:pathData="
          M 26,36
          L 82,36
          L 82,45
          L 75,45
          L 75,78
          L 64,78
          L 64,45
          L 44,45
          L 44,78
          L 33,78
          L 33,45
          L 26,45
          Z" />

</vector>
