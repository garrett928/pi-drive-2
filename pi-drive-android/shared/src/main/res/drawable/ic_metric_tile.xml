<!--
    Generic gauge icon used as the required image for Car App Library GridItems.

    The Car App Library mandates that every GridItem in a GridTemplate carry an
    image (or be flagged as loading). Our automotive dashboards are value-centric
    (the metric value is the GridItem title, the metric name is its text), so this
    neutral dial glyph satisfies the API contract while reinforcing the "gauge"
    visual language without distracting from the numbers.

    Tinted at render time via CarColor.DEFAULT so it adapts to the head unit theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- Outer dial ring -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3C7.03,3 3,7.03 3,12C3,16.97 7.03,21 12,21C16.97,21 21,16.97 21,12C21,7.03 16.97,3 12,3ZM12,19C8.13,19 5,15.87 5,12C5,8.13 8.13,5 12,5C15.87,5 19,8.13 19,12C19,15.87 15.87,19 12,19Z" />
    <!-- Needle pointing up-right -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12L16,8.5L12.8,12.9C12.55,13.2 12.1,13.25 11.78,13C11.46,12.75 11.4,12.3 11.65,11.98C11.75,11.86 11.87,11.78 12,11.74Z" />
    <!-- Hub -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12m-1.6,0a1.6,1.6 0,1 1,3.2 0a1.6,1.6 0,1 1,-3.2 0" />
</vector>
