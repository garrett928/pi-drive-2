# Pi Drive Server — environment variable reference
# Copy this file to deploy/.env and fill in real values before running.
# Never commit the .env file to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL+TimescaleDB connection string.
# For docker-compose, the host is the service name ('timescaledb').
DATABASE_URL=postgresql+psycopg://pidrive:pidrive@timescaledb:5432/pidrive

# Static API key accepted by the Android app and the management UI.
# Must be a long random string in production (e.g. openssl rand -hex 32).
API_KEY=change-me-use-a-long-random-string

# Alternatively, store the key in a file (for Docker/K8s secrets):
# API_KEY_FILE=/run/secrets/api_key

# Flask session signing key. Must be a long random string.
SECRET_KEY=change-me-use-a-different-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Runtime environment label. Affects log_format default and log label.
# Options: dev | prod
ENV=prod

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: 'json' (one JSON object per line, for Alloy/Loki) or 'text' (human-readable).
# Default: json in prod, text in dev.
# LOG_FORMAT=json

# Opt-in: gate the web UI behind an API-key login form (true/false). Default:
# false — no login required (the REST API stays key-guarded regardless). Set
# true for deployments exposed beyond a trusted network.
# UI_REQUIRE_AUTH=false

# Maximum allowed decompressed request body size in bytes. Default: 10 MB.
# MAX_BODY_BYTES=10485760

# TimescaleDB retention policy. Unset = keep all data forever.
# TELEMETRY_RETENTION_DAYS=365

# Number of gunicorn worker processes (Phase 7). Default: 2.
# GUNICORN_WORKERS=2

# Directory holding pg_dump/pg_restore for backup/restore (§8). Empty = resolve
# on PATH (the image installs postgresql-client-16). Set only if they live
# outside PATH (e.g. a Homebrew keg in local dev).
# PG_BIN_DIR=

# Set to 0 to skip in-container Alembic migrations on boot (run the K8s
# migration Job instead). Default: 1 (migrate on boot, advisory-locked).
# RUN_MIGRATIONS=1

# ── Observability (Phase 8, --profile observability) ──────────────────────────
# Where Alloy forwards parsed logs. For the bundled stack this is the loki
# service; for Grafana Cloud, point at your tenant push URL.
# LOKI_URL=http://loki:3100/loki/api/v1/push
